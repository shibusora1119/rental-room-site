---
<footer class="footer">
	<div class="container footer-inner">
		<div class="brand">
			<div class="logo">
				<span class="logo-jp">渋空</span>
				<span class="logo-en">Shibusora</span>
			</div>
			<p class="tagline">渋谷の「空」を感じる、静謐な空間</p>
		</div>
		<div class="links">
			<a href="#concept">Concept</a>
			<a href="#amenities">Amenities</a>
			<a href="#contact">Contact</a>
			<a href="#access">Access</a>
			<a href="#">Privacy Policy</a>
		</div>
		<div class="copyright">
			&copy; {new Date().getFullYear()} Shibusora. All rights reserved.
		</div>
	</div>
</footer>

<style>
	.footer {
		background: var(--text-main);
		color: #fff;
		padding: 4rem 0 2rem;
	}
	.footer-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.brand {
		margin-bottom: 2rem;
	}
	.logo {
		display: flex;
		flex-direction: column;
		margin-bottom: 0.5rem;
	}
	.logo-jp {
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}
	.logo-en {
		font-size: 0.75rem;
		opacity: 0.6;
		text-transform: uppercase;
		letter-spacing: 0.2em;
	}
	.tagline {
		font-size: 0.9rem;
		opacity: 0.8;
	}
	.links {
		display: flex;
		gap: 2rem;
		margin-bottom: 3rem;
	}
	.links a {
		font-size: 0.9rem;
		opacity: 0.7;
		transition: opacity 0.2s;
	}
	.links a:hover {
		opacity: 1;
	}
	.copyright {
		font-size: 0.8rem;
		opacity: 0.5;
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		width: 100%;
	}
	@media (max-width: 768px) {
		.links {
			flex-direction: column;
			gap: 1rem;
		}
	}
</style>
